# Local agent config. The repo contract files under .claude/ ARE tracked:
# settings.json, global.md, hooks/, and the skills symlink into .agents/.
# Everything else there is per-machine state.
.claude/*
!.claude/settings.json
!.claude/global.md
!.claude/hooks/
!.claude/skills

