{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /absolute/path/to/your/katagami/checkout/hooks/trajectory-capture/capture.py enqueue"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /absolute/path/to/your/katagami/checkout/hooks/trajectory-capture/capture.py process"
          }
        ]
      }
    ]
  },
  "env": {
    "KATAGAMI_AGENT_ID": "katagami-contributor",
    "KATAGAMI_ACTOR_SPEC": "CuratorAgent",
    "KATAGAMI_TRAJECTORY_SCRIPT": "/absolute/path/to/your/katagami/checkout/scripts/trajectory/claude_session_to_ots.py",
    "TEMPER_API_URL": "https://your-temper-host",
    "TEMPER_TENANT_ID": "default"
  }
}
